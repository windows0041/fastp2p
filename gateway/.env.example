OPENP2P_USER=your-user
OPENP2P_PASSWORD=replace-with-a-long-random-password
# Optional stable uint64 installation token; otherwise derived from user/password.
OPENP2P_TOKEN=
# Local debugging only; set to 0.0.0.0 for your server after choosing its address.
OPENP2P_BIND=127.0.0.1
GATEWAY_UID=1000
GATEWAY_GID=1000
