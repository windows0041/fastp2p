# Build from the official signed Wintun archive. Do not repack the driver DLL.
set(FASTP2P_WINTUN_VERSION 0.14.1)
set(wintun_hash 07c256185d6ee3652e09fa55c0b673e2624b565e02c4b9091c79ca7d2f24ef51)
set(wintun_dir "${CMAKE_CURRENT_BINARY_DIR}/wintun-${FASTP2P_WINTUN_VERSION}")
set(wintun_zip "${wintun_dir}.zip")
if(EXISTS "${wintun_zip}")
  file(SHA256 "${wintun_zip}" cached_hash)
endif()
if(NOT cached_hash STREQUAL wintun_hash)
  file(DOWNLOAD "https://www.wintun.net/builds/wintun-${FASTP2P_WINTUN_VERSION}.zip"
    "${wintun_zip}" EXPECTED_HASH "SHA256=${wintun_hash}" TLS_VERIFY ON TIMEOUT 40)
endif()
set(FASTP2P_WINTUN_INCLUDE "${wintun_dir}/wintun/include")
set(FASTP2P_WINTUN_LICENSE "${wintun_dir}/wintun/LICENSE.txt")
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
  set(wintun_arch amd64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$")
  set(wintun_arch arm64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86|i[3-6]86)$")
  set(wintun_arch x86)
else()
  message(FATAL_ERROR "Wintun has no FastP2P package for ${CMAKE_SYSTEM_PROCESSOR}")
endif()
set(wintun_dll "${wintun_dir}/wintun/bin/${wintun_arch}/wintun.dll")
file(MAKE_DIRECTORY "${wintun_dir}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${wintun_zip}"
  WORKING_DIRECTORY "${wintun_dir}" RESULT_VARIABLE extracted)
if(NOT extracted EQUAL 0 OR NOT EXISTS "${wintun_dll}")
  message(FATAL_ERROR "Could not extract Wintun")
endif()
enable_language(RC)
set(FASTP2P_WINTUN_RESOURCE "${CMAKE_CURRENT_BINARY_DIR}/fastp2p-wintun.rc")
file(CONFIGURE OUTPUT "${FASTP2P_WINTUN_RESOURCE}" CONTENT "101 RCDATA \"${wintun_dll}\"\n" @ONLY)
install(FILES "${FASTP2P_WINTUN_LICENSE}" DESTINATION licenses RENAME wintun-LICENSE.txt)
