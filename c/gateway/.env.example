OPENP2P_USER=replace-with-admin-name
OPENP2P_PASSWORD=replace-with-a-long-random-password
# Generate a nonzero random uint64; keep the real value outside the repository.
OPENP2P_TOKEN=replace-with-decimal-uint64
OPENP2P_TLS_CERT=/etc/openp2p-c/tls/server.crt
OPENP2P_TLS_KEY=/etc/openp2p-c/tls/server.key
