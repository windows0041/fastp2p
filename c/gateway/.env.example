FASTP2P_USER=replace-with-admin-name
FASTP2P_PASSWORD=replace-with-a-long-random-password
# Generate a nonzero random uint64; keep the real value outside the repository.
FASTP2P_TOKEN=replace-with-decimal-uint64
FASTP2P_TLS_CERT=/etc/fastp2p/tls/server.crt
FASTP2P_TLS_KEY=/etc/fastp2p/tls/server.key
FASTP2P_DATABASE=/var/lib/fastp2p/nodes.sqlite3
FASTP2P_PUBLIC_HOST=gateway.example.com
FASTP2P_CA_FILE=/etc/fastp2p/tls/ca.crt
