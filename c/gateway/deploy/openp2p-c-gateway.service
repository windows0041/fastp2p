[Unit]
Description=OpenP2P C self-hosted gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openp2p
Group=openp2p
EnvironmentFile=/etc/openp2p-c/gateway.env
ExecStart=/opt/openp2p-c/bin/openp2p-gateway-c --bind 0.0.0.0 --apibind 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
LimitNOFILE=4096
UMask=0077

[Install]
WantedBy=multi-user.target
