@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/fastp2pTargets.cmake")
if(MSVC)
  set(_fastp2p_implib "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/fastp2p.lib")
  if(NOT EXISTS "${_fastp2p_implib}")
    message(FATAL_ERROR "MSVC requires fastp2p.lib from the Windows SDK package")
  endif()
  get_target_property(_fastp2p_configs fastp2p::fastp2p IMPORTED_CONFIGURATIONS)
  foreach(_fastp2p_config IN LISTS _fastp2p_configs)
    set_property(TARGET fastp2p::fastp2p PROPERTY "IMPORTED_IMPLIB_${_fastp2p_config}" "${_fastp2p_implib}")
  endforeach()
  unset(_fastp2p_configs)
  unset(_fastp2p_config)
  unset(_fastp2p_implib)
endif()
check_required_components(fastp2p)
