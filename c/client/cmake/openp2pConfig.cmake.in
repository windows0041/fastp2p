@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/openp2pTargets.cmake")
if(MSVC)
  set(_op2p_implib "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/openp2p.lib")
  if(NOT EXISTS "${_op2p_implib}")
    message(FATAL_ERROR "MSVC requires openp2p.lib from the Windows SDK package")
  endif()
  get_target_property(_op2p_configs openp2p::openp2p IMPORTED_CONFIGURATIONS)
  foreach(_op2p_config IN LISTS _op2p_configs)
    set_property(TARGET openp2p::openp2p PROPERTY "IMPORTED_IMPLIB_${_op2p_config}" "${_op2p_implib}")
  endforeach()
  unset(_op2p_configs)
  unset(_op2p_config)
  unset(_op2p_implib)
endif()
check_required_components(openp2p)
