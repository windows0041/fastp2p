set(OP2P_DEPS_ROOT "" CACHE PATH "Prefix produced by scripts/build-deps.py")
set(OP2P_DEPS_BASE "" CACHE PATH "Directory containing per-target dependency prefixes")
if(ANDROID AND OP2P_DEPS_BASE AND NOT OP2P_DEPS_ROOT)
  set(OP2P_DEPS_ROOT "${OP2P_DEPS_BASE}/android-${ANDROID_ABI}")
endif()
set(OP2P_QUIC_TLS "GNUTLS" CACHE STRING "QUIC TLS provider: GNUTLS or OPENSSL")
set_property(CACHE OP2P_QUIC_TLS PROPERTY STRINGS GNUTLS OPENSSL)
if(OP2P_DEPS_ROOT)
  set(OP2P_QUIC_TLS OPENSSL CACHE STRING "QUIC TLS provider" FORCE)
  function(op2p_import name)
    find_library(${name}_PATH NAMES ${ARGN} PATHS "${OP2P_DEPS_ROOT}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    add_library(${name} STATIC IMPORTED)
    set_target_properties(${name} PROPERTIES IMPORTED_LOCATION "${${name}_PATH}"
      INTERFACE_INCLUDE_DIRECTORIES "${OP2P_DEPS_ROOT}/include")
  endfunction()
  op2p_import(op2p_crypto crypto)
  op2p_import(op2p_ssl ssl)
  op2p_import(op2p_ngtcp2 ngtcp2)
  op2p_import(op2p_ngtcp2_crypto ngtcp2_crypto_ossl)
  op2p_import(op2p_curl curl libcurl)
  op2p_import(op2p_json json-c)
  set_property(TARGET op2p_ssl PROPERTY INTERFACE_LINK_LIBRARIES op2p_crypto)
  set_property(TARGET op2p_ngtcp2_crypto PROPERTY INTERFACE_LINK_LIBRARIES "op2p_ngtcp2;op2p_ssl")
  if(WIN32)
    set_property(TARGET op2p_crypto PROPERTY INTERFACE_LINK_LIBRARIES "ws2_32;crypt32;bcrypt;advapi32")
    set_property(TARGET op2p_curl PROPERTY INTERFACE_LINK_LIBRARIES "ws2_32;crypt32;bcrypt;secur32;normaliz;iphlpapi;advapi32;wldap32")
  else()
    find_package(Threads REQUIRED)
    set_property(TARGET op2p_crypto PROPERTY INTERFACE_LINK_LIBRARIES "Threads::Threads;${CMAKE_DL_LIBS}")
    set_property(TARGET op2p_curl PROPERTY INTERFACE_LINK_LIBRARIES op2p_ssl)
    if(APPLE)
      set_property(TARGET op2p_curl APPEND PROPERTY INTERFACE_LINK_LIBRARIES "-framework Security" "-framework CoreFoundation" "-framework SystemConfiguration")
    endif()
  endif()
  add_compile_definitions(CURL_STATICLIB NGTCP2_STATICLIB JSON_C_STATIC)
  set(OP2P_QUIC_TARGET op2p_ngtcp2_crypto)
  set(OP2P_WEB_TARGET op2p_curl)
  set(OP2P_JSON_TARGET op2p_json)
  set(OP2P_CRYPTO_TARGET op2p_crypto)
else()
  find_package(PkgConfig REQUIRED)
  if(OP2P_QUIC_TLS STREQUAL "OPENSSL")
    pkg_check_modules(QUIC REQUIRED IMPORTED_TARGET libngtcp2>=1.22 libngtcp2_crypto_ossl)
  else()
    pkg_check_modules(QUIC REQUIRED IMPORTED_TARGET libngtcp2>=1.11 libngtcp2_crypto_gnutls gnutls)
  endif()
  pkg_check_modules(WSS REQUIRED IMPORTED_TARGET libcurl>=8.14)
  pkg_check_modules(JSON REQUIRED IMPORTED_TARGET json-c>=0.16)
  find_package(OpenSSL REQUIRED)
  set(OP2P_QUIC_TARGET PkgConfig::QUIC)
  set(OP2P_WEB_TARGET PkgConfig::WSS)
  set(OP2P_JSON_TARGET PkgConfig::JSON)
  set(OP2P_CRYPTO_TARGET OpenSSL::Crypto)
  if(OP2P_QUIC_TLS STREQUAL "OPENSSL")
    set_property(TARGET PkgConfig::QUIC APPEND PROPERTY INTERFACE_LINK_LIBRARIES OpenSSL::SSL)
  endif()
endif()
if(OP2P_QUIC_TLS STREQUAL "OPENSSL")
  add_compile_definitions(OP2P_QUIC_OPENSSL=1)
endif()
