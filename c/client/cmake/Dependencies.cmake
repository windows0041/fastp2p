set(FASTP2P_DEPS_ROOT "" CACHE PATH "Prefix produced by scripts/build-deps.py")
set(FASTP2P_DEPS_BASE "" CACHE PATH "Directory containing per-target dependency prefixes")
if(ANDROID AND FASTP2P_DEPS_BASE AND NOT FASTP2P_DEPS_ROOT)
  set(FASTP2P_DEPS_ROOT "${FASTP2P_DEPS_BASE}/android-${ANDROID_ABI}")
endif()
# QUIC uses ngtcp2 with the OpenSSL backend on every platform.  The client also
# needs OpenSSL for the tunnel AEAD layer, so a second TLS backend would only
# add surface without adding capability.
if(FASTP2P_DEPS_ROOT)
  function(fastp2p_import name)
    find_library(${name}_PATH NAMES ${ARGN} PATHS "${FASTP2P_DEPS_ROOT}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    add_library(${name} STATIC IMPORTED)
    set_target_properties(${name} PROPERTIES IMPORTED_LOCATION "${${name}_PATH}"
      INTERFACE_INCLUDE_DIRECTORIES "${FASTP2P_DEPS_ROOT}/include")
  endfunction()
  fastp2p_import(fastp2p_crypto crypto)
  fastp2p_import(fastp2p_ssl ssl)
  fastp2p_import(fastp2p_ngtcp2 ngtcp2)
  fastp2p_import(fastp2p_ngtcp2_crypto ngtcp2_crypto_ossl)
  fastp2p_import(fastp2p_curl curl libcurl)
  fastp2p_import(fastp2p_json json-c)
  set_property(TARGET fastp2p_ssl PROPERTY INTERFACE_LINK_LIBRARIES fastp2p_crypto)
  set_property(TARGET fastp2p_ngtcp2_crypto PROPERTY INTERFACE_LINK_LIBRARIES "fastp2p_ngtcp2;fastp2p_ssl")
  if(WIN32)
    set_property(TARGET fastp2p_crypto PROPERTY INTERFACE_LINK_LIBRARIES "ws2_32;crypt32;bcrypt;advapi32")
    set_property(TARGET fastp2p_curl PROPERTY INTERFACE_LINK_LIBRARIES "ws2_32;crypt32;bcrypt;secur32;normaliz;iphlpapi;advapi32;wldap32")
  else()
    find_package(Threads REQUIRED)
    set_property(TARGET fastp2p_crypto PROPERTY INTERFACE_LINK_LIBRARIES "Threads::Threads;${CMAKE_DL_LIBS}")
    set_property(TARGET fastp2p_curl PROPERTY INTERFACE_LINK_LIBRARIES fastp2p_ssl)
    if(APPLE)
      set_property(TARGET fastp2p_curl APPEND PROPERTY INTERFACE_LINK_LIBRARIES "-framework Security" "-framework CoreFoundation" "-framework SystemConfiguration")
    endif()
  endif()
  add_compile_definitions(CURL_STATICLIB NGTCP2_STATICLIB JSON_C_STATIC)
  set(FASTP2P_QUIC_TARGET fastp2p_ngtcp2_crypto)
  set(FASTP2P_WEB_TARGET fastp2p_curl)
  set(FASTP2P_JSON_TARGET fastp2p_json)
  set(FASTP2P_CRYPTO_TARGET fastp2p_crypto)
else()
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(QUIC REQUIRED IMPORTED_TARGET libngtcp2>=1.22 libngtcp2_crypto_ossl)
  pkg_check_modules(WSS REQUIRED IMPORTED_TARGET libcurl>=8.14)
  pkg_check_modules(JSON REQUIRED IMPORTED_TARGET json-c>=0.16)
  find_package(OpenSSL REQUIRED)
  set(FASTP2P_QUIC_TARGET PkgConfig::QUIC)
  set(FASTP2P_WEB_TARGET PkgConfig::WSS)
  set(FASTP2P_JSON_TARGET PkgConfig::JSON)
  set(FASTP2P_CRYPTO_TARGET OpenSSL::Crypto)
  set_property(TARGET PkgConfig::QUIC APPEND PROPERTY INTERFACE_LINK_LIBRARIES OpenSSL::SSL)
endif()
